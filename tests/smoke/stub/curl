#!/bin/sh
# Stands in for curl in the smoke tests, so they never go online. It knows
# AniList's answer about two titles: a search for "fullmetal" finds two
# anime, and "Odd Taxi" one. As curl -w '\n%{http_code}' does, the status
# follows the body on a line of its own; anything else is AniList's 404.

body=
for argument in "$@"; do
	if [ "$argument" = "@-" ]; then
		body=$(cat)
	fi
done

case "$body" in
*'"search":"Odd Taxi"'*)
	printf '%s\n' '{"data":{"anime":{"media":[{"id":128547,"idMal":44265,"title":{"romaji":"Odd Taxi"},"episodes":13,"format":"TV"}]},"manga":{"media":[]}}}'
	printf '200'
	;;
*'"search":"fullmetal"'*)
	printf '%s\n' '{"data":{"anime":{"media":[{"id":5114,"idMal":5114,"title":{"romaji":"Fullmetal Alchemist: Brotherhood"},"episodes":64,"format":"TV","startDate":{"year":2009}},{"id":121,"idMal":121,"title":{"romaji":"Fullmetal Alchemist"},"episodes":51,"format":"TV","startDate":{"year":2003}}]},"manga":{"media":[]}}}'
	printf '200'
	;;
*)
	printf '%s\n404' '{"errors":[{"message":"Not Found.","status":404}]}'
	;;
esac
