#!/bin/sh
# Stands in for curl in the smoke tests, so they never go online. It knows
# AniList's answers about one title, Fullmetal Alchemist: a search for
# "fullmetal" finds two anime, and the look-up of id 121 finds the older.
# As curl -w '\n%{http_code}' does, the status follows the body on a line of
# its own; anything else is AniList's 404.

body=
for argument in "$@"; do
	if [ "$argument" = "@-" ]; then
		body=$(cat)
	fi
done

case "$body" in
*'"search":"fullmetal","type":"ANIME"'*)
	printf '%s\n' '{"data":{"Page":{"media":[{"id":5114,"idMal":5114,"title":{"romaji":"Fullmetal Alchemist: Brotherhood"},"episodes":64,"startDate":{"year":2009}},{"id":121,"idMal":121,"title":{"romaji":"Fullmetal Alchemist"},"episodes":51,"startDate":{"year":2003}}]}}}'
	printf '200'
	;;
*'{"id":121,"type":"ANIME"'*)
	printf '%s\n' '{"data":{"Media":{"id":121,"idMal":121,"title":{"romaji":"Fullmetal Alchemist"},"episodes":51,"status":"FINISHED"}}}'
	printf '200'
	;;
*)
	printf '%s\n404' '{"errors":[{"message":"Not Found.","status":404}]}'
	;;
esac
